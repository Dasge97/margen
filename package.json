{
  "name": "margen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file=.env --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-vue-next": "^0.468.0",
    "nodemailer": "^7.0.6",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "vue": "^3.5.21",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
